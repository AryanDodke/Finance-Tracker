# Spend Analyser Environment Configuration
# Copy this file to .env and fill in your API keys

# ─── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./spend_analyser.db

# ─── LLM API Keys (fill in whichever you have) ───────────────────────────
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ─── LLM Provider Order (comma-separated) ────────────────────────────────
LLM_PROVIDER_ORDER=claude,gemini,groq,openrouter

# ─── Thresholds ──────────────────────────────────────────────────────────
CATEGORISATION_CONFIDENCE_THRESHOLD=0.8
RECONCILE_MATCH_THRESHOLD=0.7
RECONCILE_GAP_THRESHOLD_PCT=0.10
RECONCILE_GAP_THRESHOLD_ABS=500.0
FUZZY_MERCHANT_THRESHOLD=90

# ─── CORS ────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── File Storage ────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
